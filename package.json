{
  "name": "vpschatbotwidget",
  "version": "1.0.2",
  "private": false,
  "description": "This is an Package for the chatbot widget ui for our customer portel . ",
  "homepage": "https://github.com/dhineshkumar-natobotics/VPS-Chatbot-Widget#readme",
  "bugs": {
    "url": "https://github.com/dhineshkumar-natobotics/VPS-Chatbot-Widget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhineshkumar-natobotics/VPS-Chatbot-Widget.git"
  },
  "license": "ISC",
  "author": "Dhineshkuamr Thirupathi",
  "type": "module",
  "main": "./dist-lib/vps-chatbot.cjs",
  "module": "./dist-lib/vps-chatbot.js",
  "types": "./dist-lib/types/chatbot/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/chatbot/index.d.ts",
      "import": "./dist-lib/vps-chatbot.js",
      "require": "./dist-lib/vps-chatbot.cjs",
      "default": "./src/chatbot/index.ts"
    },
    "./chatbot": {
      "types": "./dist-lib/types/chatbot/index.d.ts",
      "import": "./dist-lib/vps-chatbot.js",
      "require": "./dist-lib/vps-chatbot.cjs",
      "default": "./src/chatbot/index.ts"
    },
    "./css": "./src/index.css"
  },
  "files": [
    "dist-lib",
    "src/chatbot",
    "src/components",
    "src/lib",
    "src/types",
    "src/index.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.json --declaration --emitDeclarationOnly --noEmit false --outDir dist-lib/types",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^5.0.1"
  }
}